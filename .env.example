# Database — `hd setup` picks this, creates the database if needed, and builds
# the schema. SQLite needs nothing installed; PostgreSQL needs the extra:
#   pip install -e ".[postgres]"
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost/hd_monitor

# API
API_ENDPOINT=https://apionline.homedepot.com/federation-gateway/graphql

# Crawl settings
# Leave these blank and run `hd setup`, which finds your store from a ZIP code
# and resolves each brand to the catalog facet token browse mode needs. A brand
# without its token is not an error — browse simply walks nothing.
STORES=
BRANDS=
BRAND_TOKENS=
PRODUCT_LINE_FILTERS=
TOOLS_NAV_PARAM=N-5yc1vZc1xy
# Additional category navParams (CSV), no product_line_filter applied.
# Must stay on its own line: dotenv reads `KEY=  # note` as the comment text.
EXTRA_NAV_PARAMS=
CLEARANCE_TOKEN=1z11adf
MAX_CONCURRENCY=3
RATE_LIMIT_RPS=1.0
JITTER_MIN_MS=200
JITTER_MAX_MS=800
MAX_PAGES=10
PAGE_SIZE=24

# Pipeline
STAGE_DELAY_SECONDS=5

# Safety
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_WINDOW_SECONDS=60
DRIFT_FAILURE_THRESHOLD_PCT=50

# Diff
DIFF_GAP_THRESHOLD_HOURS=48
DIFF_STALE_GAP_HOURS=168

# Maintenance
SNAPSHOT_RETENTION_DAYS=90

# Coverage rotation — each run walks a slice of pages starting where the previous
# run stopped, rather than restarting at page 0 and never reaching the tail.
ROTATION_ENABLED=true
ROTATION_CURSOR_PATH=.hd_rotation_cursor
ROTATION_SLICE_PAGES=8

# Pages per keyword for the supplementary storefilter=ALL pass, which catches
# online-only items. Runs before the main passes so the budget cannot starve it.
ONLINE_PASS_MAX_PAGES=3

# Storage
STORE_RAW_JSON=true
RAW_JSON_DIR=./raw_responses

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_TITLE=HD Clearance Monitor
DASHBOARD_REFRESH_SECONDS=300
DASHBOARD_DARK_MODE=true

# Slack (optional) — `hd setup` fills these in after verifying they work.
# Needs a Slack app with chat:write; canvases:write adds the deal rundown,
# which free Slack workspaces cannot create.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
CANVAS_ENABLED=true
CANVAS_TITLE=Deal Rundown

# Optional notifiers (unused)
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
