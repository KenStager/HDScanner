<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kstager.hdscanner.dashboard</string>

  <!-- Long-running NiceGUI dashboard. Bound to loopback only. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>export PYTHONUNBUFFERED=1; cd /Users/kstager/HDScanner &amp;&amp; . .venv/bin/activate &amp;&amp; hd serve --host 127.0.0.1 --port 8080</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kstager/HDScanner</string>

  <key>StandardOutPath</key>
  <string>/Users/kstager/HDScanner/hd_dashboard.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kstager/HDScanner/hd_dashboard.stderr.log</string>

  <!-- Unlike the scanner job, this one is a service: start at load and restart
       if it exits. ThrottleInterval keeps a crash-loop from spinning hot. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
